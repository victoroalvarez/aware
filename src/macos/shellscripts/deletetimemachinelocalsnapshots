#!/bin/bash

set -euo pipefail

# Ask the user to confirm the deletion action
read -r -p "Delete ALL local Time Machine snapshots? [y/N] " response

# Confirm deletion, if not exit
if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]
then
        # Delete timemachine snapshots
        sudo tmutil deletelocalsnapshots /
else
        echo "No Snapshots Deleted."; exit 1;
fi
