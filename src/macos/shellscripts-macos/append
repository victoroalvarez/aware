#!/bin/bash
# append
# Append a word or string to the end of a text-file.

# Test for help option. If -h or --help is passed as argument, print the message and exit.
case "$1" in
	-h | --help)
		echo "Take first argument and append it to the text-file passed as a second argument"
		exit 0
		;;
esac

# Take first argument and append it to the text-file passed as a second argument
echo "$1" >> "$2"; 
